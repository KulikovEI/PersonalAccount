@using PersonalAccount.Models
@model AddDisciplineViewModel

<div class="container d-flex align-content-center justify-content-center mt-4">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">
                Добавление дисциплины
            </h1>
        </header>
        <form class="card-body" method="post">
            <div class="alert-danger alert" asp-validation-summary="ModelOnly"></div>

            <div class="mb-4">
                <label class="form-label" asp-for="Name">Название дисциплины</label>
                <input class="form-control" asp-for="Name" autocomplete="off" placeholder="Например: Архитектура ИС" />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary w-50">
                    Назад
                </a>
                <button class="btn btn-primary w-50" type="submit">
                    Создать
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
