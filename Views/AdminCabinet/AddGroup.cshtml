@using PersonalAccount.Models
@model AddGroupViewModel

<div class="container d-flex align-content-center justify-content-center mt-4">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">
                Создание группы
            </h1>
        </header>
        <form class="card-body" method="post">
            <div class="alert-danger alert" asp-validation-summary="ModelOnly"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Name">Название группы</label>
                <input class="form-control" asp-for="Name" autocomplete="off" placeholder="Например: ПИ-201" />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Description">Описание / Направление</label>
                <textarea class="form-control" asp-for="Description" rows="3" placeholder="Краткое описание курса..."></textarea>
                <span class="text-danger small" asp-validation-for="Description"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="ImageUrl">Ссылка на обложку группы</label>
                <input class="form-control" asp-for="ImageUrl" autocomplete="off" placeholder="https://example.com" />
                <span class="text-danger small" asp-validation-for="ImageUrl"></span>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary w-50">
                    Назад
                </a>
                <button class="btn btn-primary w-50" type="submit">
                    Создать
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}