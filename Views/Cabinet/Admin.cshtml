@model PersonalAccount.ViewModels.AdminCabinetViewModel
@{
    ViewData["Title"] = "Кабинет администратора";
}

<div class="container py-4">
    <h1 class="mb-4 text-uppercase h3 text-secondary">Панель администратора</h1>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var student in Model.Students)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-2">@student.FullName</h5>
                            <p class="card-text mb-3 text-muted"><strong>Группа:</strong> @student.GroupName</p>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                            @if (student.IsEmailConfirmed)
                            {
                                <span class="badge bg-success text-uppercase py-2 px-3 rounded-pill">
                                    Почта подтверждена
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark text-uppercase py-2 px-3 rounded-pill">
                                    Почта не подтверждена
                                </span>

                                <form asp-controller="Cabinet" asp-action="ConfirmStudentEmail" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@student.AccountId" />
                                    <button type="submit" class="btn btn-sm btn-danger fw-semibold shadow-sm px-3">
                                        Подтвердить почту
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>